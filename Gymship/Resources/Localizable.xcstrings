{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "Couldn't find that address.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró esa dirección."
          }
        }
      }
    },
    "Couldn't calculate a driving route.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo calcular una ruta en coche."
          }
        }
      }
    },
    "Calendar access has not been granted.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha concedido acceso al calendario."
          }
        }
      }
    },
    "No calendar source is available to create the Workout calendar.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna fuente de calendario disponible para crear el calendario de entrenamientos."
          }
        }
      }
    },
    "Ice": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hielo"
          }
        }
      }
    },
    "Sky": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cielo"
          }
        }
      }
    },
    "Classic": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clásico"
          }
        }
      }
    },
    "Electric": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eléctrico"
          }
        }
      }
    },
    "Neon": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Neón"
          }
        }
      }
    },
    "Deep": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Profundo"
          }
        }
      }
    },
    "Muted": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suave"
          }
        }
      }
    },
    "Slate": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pizarra"
          }
        }
      }
    },
    "Unknown": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconocido"
          }
        }
      }
    },
    "Athlete": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atleta"
          }
        }
      }
    },
    "New": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuevo"
          }
        }
      }
    },
    "Better": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejorado"
          }
        }
      }
    },
    "Fixed": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corregido"
          }
        }
      }
    },
    "A whole new look": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aspecto totalmente nuevo"
          }
        }
      }
    },
    "The week dial": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dial semanal"
          }
        }
      }
    },
    "Your Plan tab is now a dial. Each day fills in when you say you're in, and glows once the workout is locked.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pestaña Plan ahora es un dial. Cada día se rellena cuando dices que te apuntas y brilla cuando el entrenamiento queda confirmado."
          }
        }
      }
    },
    "One-tap “I'm in”": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Me apunto” con un toque"
          }
        }
      }
    },
    "Sessions are tickets now. Tap I'm in, and when a second person joins, the workout locks.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sesiones ahora son entradas. Toca Me apunto y, cuando se une una segunda persona, el entrenamiento queda confirmado."
          }
        }
      }
    },
    "Leave times": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Horas de salida"
          }
        }
      }
    },
    "The ride planner shows a map and tells everyone when to leave, or when to be ready for pickup.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El planificador de trayecto muestra un mapa e indica a todos cuándo salir o cuándo estar listos para que los recojan."
          }
        }
      }
    },
    "Sign in with Apple": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar sesión con Apple"
          }
        }
      }
    },
    "No more Google sign-in. One tap with Apple, and no password.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se acabó el inicio de sesión con Google. Un toque con Apple y sin contraseña."
          }
        }
      }
    },
    "Liquid Glass": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glass"
          }
        }
      }
    },
    "New glass surfaces, rounded type throughout, and a color background that slowly drifts. Needs iOS 26.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuevas superficies de cristal, tipografía redondeada en todo el app y un fondo de color que se desplaza lentamente. Requiere iOS 26."
          }
        }
      }
    },
    "Crews you can share": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crews que puedes compartir"
          }
        }
      }
    },
    "Send your invite code straight from the crew screen.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía tu código de invitación directamente desde la pantalla del crew."
          }
        }
      }
    },
    "Launch crash on iOS 27": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierre al abrir en iOS 27"
          }
        }
      }
    },
    "The app no longer closes itself on launch on iOS 27.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app ya no se cierra sola al abrirse en iOS 27."
          }
        }
      }
    },
    "Cleaner, and higher contrast": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más limpio y con más contraste"
          }
        }
      }
    },
    "High contrast mode": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo de alto contraste"
          }
        }
      }
    },
    "Turn it on in You. Pure black and white, with no glass anywhere except the tab bar.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo en Tú. Blanco y negro puros, sin cristal en ningún sitio salvo la barra de pestañas."
          }
        }
      }
    },
    "Font choice": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elección de fuente"
          }
        }
      }
    },
    "Switch between SF Pro Rounded and the standard system font in You.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia entre SF Pro Rounded y la fuente estándar del sistema en Tú."
          }
        }
      }
    },
    "What's new": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Novedades"
          }
        }
      }
    },
    "This screen. You'll see it after every update, and you can reopen it any time from You.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pantalla. La verás tras cada actualización y puedes volver a abrirla cuando quieras desde Tú."
          }
        }
      }
    },
    "Today on the dial": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy en el dial"
          }
        }
      }
    },
    "Today is now marked with an outline around its segment instead of a circle behind the number.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy ahora se marca con un contorno alrededor de su segmento en lugar de un círculo detrás del número."
          }
        }
      }
    },
    "A calmer Plan tab": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pestaña Plan más tranquila"
          }
        }
      }
    },
    "The week dial floats on the background instead of sitting in a card, with more room around it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dial semanal flota sobre el fondo en lugar de estar en una tarjeta, con más espacio alrededor."
          }
        }
      }
    },
    "Roomier session cards": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarjetas de sesión más amplias"
          }
        }
      }
    },
    "Who's in and whether it's locked now read at a glance, and the “In” button stops getting squeezed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quién se apunta y si está confirmado se lee de un vistazo, y el botón “Apuntado” ya no queda apretado."
          }
        }
      }
    },
    "Week dial numbers": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Números del dial semanal"
          }
        }
      }
    },
    "The day numbers now sit inside their segments instead of hanging off the edge.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los números de los días ahora quedan dentro de sus segmentos en lugar de sobresalir por el borde."
          }
        }
      }
    },
    "Phantom error banner": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso de error fantasma"
          }
        }
      }
    },
    "The red “cancellation error” message no longer pops up when a refresh is interrupted.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje rojo de “error de cancelación” ya no aparece cuando se interrumpe una actualización."
          }
        }
      }
    },
    "Faster, and easier on the eyes": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más rápido y más agradable a la vista"
          }
        }
      }
    },
    "What to test": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué probar"
          }
        }
      }
    },
    "A tester's guide to Gymship, shown once after onboarding and reachable any time from You — with a one-tap way to invite a friend.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una guía para probadores de Gymship, que se muestra una vez tras la introducción y está siempre disponible en Tú, con una forma rápida de invitar a un amigo."
          }
        }
      }
    },
    "A softer high contrast": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un alto contraste más suave"
          }
        }
      }
    },
    "Less stark: soft tonal surfaces and the system's own switches, instead of hard white outlines and glowing edges.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos áspero: superficies tonales suaves y los interruptores del propio sistema, en lugar de contornos blancos duros y bordes brillantes."
          }
        }
      }
    },
    "Faster AI suggestions": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerencias de IA más rápidas"
          }
        }
      }
    },
    "Solo and crew workout suggestions for the week now compute all at once instead of one day at a time.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sugerencias de entrenamiento individuales y de crew para la semana ahora se calculan todas a la vez en lugar de día por día."
          }
        }
      }
    },
    "Quicker ride planning": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Planificación de trayectos más rápida"
          }
        }
      }
    },
    "Everyone's ETA calculates at the same time now, instead of waiting on each person in turn.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora de llegada de todos se calcula ahora a la vez, en lugar de esperar a cada persona por turno."
          }
        }
      }
    },
    "Refined proportions": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proporciones refinadas"
          }
        }
      }
    },
    "A pass over spacing and sizing across the app so it feels more like it was designed by Apple, on every screen size.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un repaso a espacios y tamaños en toda la app para que parezca diseñada por Apple, en cualquier tamaño de pantalla."
          }
        }
      }
    },
    "Calendar list": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista de calendarios"
          }
        }
      }
    },
    "Birthdays and Holidays no longer show up in the list of calendars you can mark busy.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cumpleaños y Festivos ya no aparecen en la lista de calendarios que puedes marcar como ocupados."
          }
        }
      }
    },
    "False error on “I'm in”": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error falso al pulsar “Me apunto”"
          }
        }
      }
    },
    "Accepting a workout no longer shows an error banner if a background step hiccups — your RSVP still goes through.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceptar un entrenamiento ya no muestra un aviso de error si falla un paso en segundo plano; tu confirmación se envía igualmente."
          }
        }
      }
    },
    "Gymship finds the free time you share with your crew and turns it into a workout — no group chat back-and-forth.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gymship encuentra el tiempo libre que compartes con tu crew y lo convierte en un entrenamiento, sin idas y venidas en el chat de grupo."
          }
        }
      }
    },
    "Sync your calendar": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza tu calendario"
          }
        }
      }
    },
    "In You → Availability, mark which calendars count as busy. Nothing about *why* you're busy ever leaves your phone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Tú → Disponibilidad, marca qué calendarios cuentan como ocupados. Nada sobre *por qué* estás ocupado sale nunca de tu teléfono."
          }
        }
      }
    },
    "Start or join a crew": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un crew o únete a uno"
          }
        }
      }
    },
    "Make a crew and send your invite code, or join a friend's from You → Start or join a crew. Up to five people.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un crew y envía tu código de invitación, o únete al de un amigo desde Tú → Crea un crew o únete a uno. Hasta cinco personas."
          }
        }
      }
    },
    "Say you're in": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Di que te apuntas"
          }
        }
      }
    },
    "Once your crew's synced, tap a proposed session and hit I'm in. A second person joining locks the workout for everyone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando tu crew esté sincronizado, toca una sesión propuesta y pulsa Me apunto. Cuando se une una segunda persona, el entrenamiento queda confirmado para todos."
          }
        }
      }
    },
    "Plan the ride": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifica el trayecto"
          }
        }
      }
    },
    "On a locked session, tap Plan the ride to pick a driver and see when everyone should leave.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una sesión confirmada, toca Planificar el trayecto para elegir conductor y ver cuándo debe salir cada uno."
          }
        }
      }
    },
    "Watch your week fill in": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira cómo se llena tu semana"
          }
        }
      }
    },
    "The Plan tab's dial tracks your weekly goal, and suggests solo sessions to fill the gaps your crew can't.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dial de la pestaña Plan sigue tu objetivo semanal y sugiere sesiones individuales para cubrir los huecos que tu crew no puede."
          }
        }
      }
    },
    "Try high contrast & fonts": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba el alto contraste y las fuentes"
          }
        }
      }
    },
    "In You, flip High contrast for an all black-and-white look, or switch between rounded and standard type.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Tú, activa Alto contraste para un aspecto totalmente en blanco y negro, o cambia entre tipografía redondeada y estándar."
          }
        }
      }
    },
    "Found something broken or confusing? Shake your phone to send feedback straight from TestFlight — screenshots included.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Algo roto o confuso? Agita el teléfono para enviar comentarios directamente desde TestFlight, con capturas incluidas."
          }
        }
      }
    },
    "You're not signed in yet.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no has iniciado sesión."
          }
        }
      }
    },
    "No group matches that invite code.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún grupo coincide con ese código de invitación."
          }
        }
      }
    },
    "This group already has the maximum of %lld members.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este grupo ya tiene el máximo de %lld miembros."
          }
        }
      }
    },
    "That @handle is already taken. Try another one.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese @usuario ya está en uso. Prueba con otro."
          }
        }
      }
    },
    "No starting address set.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha indicado una dirección de salida."
          }
        }
      }
    },
    "Waiting on the driver's starting address.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando la dirección de salida del conductor."
          }
        }
      }
    },
    "Set the gym location first.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero define la ubicación del gimnasio."
          }
        }
      }
    },
    "Calendar access was denied. You can enable it later in Settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se denegó el acceso al calendario. Puedes activarlo más tarde en Ajustes."
          }
        }
      }
    },
    "Apple didn't return a valid identity token.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no devolvió un token de identidad válido."
          }
        }
      }
    },
    "Your calendar, private": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu calendario, privado"
          }
        }
      }
    },
    "Mark which calendars count as busy. Gymship shares only when you're busy — never why.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca qué calendarios cuentan como ocupados. Gymship solo comparte cuándo estás ocupado, nunca por qué."
          }
        }
      }
    },
    "Start a crew": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un crew"
          }
        }
      }
    },
    "Make a crew and share its invite code, or join a friend's. Up to five people per crew.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un crew y comparte su código de invitación, o únete al de un amigo. Hasta cinco personas por crew."
          }
        }
      }
    },
