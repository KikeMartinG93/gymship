        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerencias"
          }
        }
      }
    },
    "Agent is typing": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agente está escribiendo"
          }
        }
      }
    },
    "A real chat": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chat de verdad"
          }
        }
      }
    },
    "Agent chat": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat del agente"
          }
        }
      }
    },
    "The Agent tab is a conversation now, like Messages — bubbles, a field, and suggested questions above it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pestaña Agente es una conversación ahora, como Mensajes: globos, un campo, y preguntas sugeridas encima."
          }
        }
      }
    },
    "Your icon, your color": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu icono, tu color"
          }
        }
      }
    },
    "Home Screen icon": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Icono de inicio"
          }
        }
      }
    },
    "Leave Appearance and the Gymship icon on the Home Screen takes the accent you picked. iOS will ask once to confirm.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al salir de Apariencia, el icono de Gymship en la pantalla de inicio toma el color que elegiste. iOS pide confirmación una vez."
          }
        }
      }
    }
  }
}